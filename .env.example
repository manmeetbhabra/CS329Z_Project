# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=sk-or-...

# Optional spending limit, enforced by utils/budget.py. START_USAGE is the key's total usage when
# you set the budget (`uv run python -m utils.balance` shows it); leave both blank for no limit.
PROJECT_BUDGET_USD=
PROJECT_BUDGET_START_USAGE=
